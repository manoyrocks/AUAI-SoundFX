{
  "name": "@soundfx/engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./worklet-src": "./src/worklet/processor.ts"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "build:worklet": "esbuild src/worklet/processor.ts --bundle --format=esm --target=es2021 --outfile=../../apps/web/public/worklets/clfs-processor.js",
    "test": "node --test test/*.test.js",
    "watch:worklet": "esbuild src/worklet/processor.ts --bundle --format=esm --target=es2021 --outfile=../../apps/web/public/worklets/clfs-processor.js --watch"
  }
}
